# پروفایل آزموده‌شدهٔ GPU؛ همراه compose.decode.yml و compose.hybrid.yml استفاده شود.
# این فایل راز یا مسیر خصوصی ندارد. cache فقط از train ساخته می‌شود.
INFERENCE_SPEC_TYPE=ngram-cache
INFERENCE_STATIC_CACHE=/lookup/train-hybrid.bin
INFERENCE_ENGINE_CONTEXT=8192
INFERENCE_ENGINE_SLOTS=4
INFERENCE_GATEWAY_SLOTS=4
INFERENCE_GATEWAY_WAITING=0
INFERENCE_CPP_WARMUP=1
INFERENCE_LOAD_MODE=mmap
