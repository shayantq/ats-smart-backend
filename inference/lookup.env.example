# cache فقط با inference.train_lookup از train ساخته شود؛ همهٔ پیشنهادها را مدل تأیید می‌کند.
INFERENCE_SPEC_TYPE=ngram-cache
INFERENCE_STATIC_CACHE=/lookup/train-original.bin
INFERENCE_ENGINE_CONTEXT=8192
INFERENCE_ENGINE_SLOTS=4
INFERENCE_GATEWAY_SLOTS=4
INFERENCE_GATEWAY_WAITING=0
INFERENCE_CPP_WARMUP=1
INFERENCE_LOAD_MODE=mmap
