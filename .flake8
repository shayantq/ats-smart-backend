[flake8]
# هم‌خوان با line-length پیکربندی Black در pyproject.toml
max-line-length = 120
# E203/W503: با سبک فرمت‌بندی Black در تضادند (توصیه‌ی رسمی مستندات Black)
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    frontend,
    media,
    # مایگریشن‌ها را Alembic خودکار تولید کرده و هرگز بعد از اجرا ویرایش نمی‌شوند
    alembic/versions
