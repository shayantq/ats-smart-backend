PROJECT_NAME=ATS Smart
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5432/smart_ats_db
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173

# ---- ذخیره‌سازی فایل رزومه ----
# "local" برای توسعه (پیش‌فرض) — "s3" برای AWS S3 یا هر Object Storage سازگار با S3
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# فقط اگر STORAGE_BACKEND=s3 باشد لازم است:
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# ---- موتور OCR (استخراج متن رزومه) ----
OCR_LANGUAGES=fas+eng
# اگر Tesseract در PATH سیستم نیست (مخصوصاً ویندوز)، مسیر کامل tesseract.exe را اینجا بده:
TESSERACT_CMD_PATH=
