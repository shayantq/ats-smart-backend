PROJECT_NAME=ATS Smart
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5432/smart_ats_db
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173

# ---- ذخیره‌سازی فایل رزومه ----
# "local" برای توسعه (پیش‌فرض) — "s3" برای AWS S3 یا هر Object Storage سازگار با S3
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# فقط اگر STORAGE_BACKEND=s3 باشد لازم است:
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# ---- موتور OCR (استخراج متن رزومه) ----
OCR_LANGUAGES=fas+eng
# اگر Tesseract در PATH سیستم نیست (مخصوصاً ویندوز)، مسیر کامل tesseract.exe را اینجا بده:
TESSERACT_CMD_PATH=

# ---- سرویس ایمیل (SMTP) — برای زیرسیستم اطلاع‌رسانی ----
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@ats-smart.local
SMTP_FROM_NAME=ATS Smart

# ---- عملیات و مانیتورینگ (DevOps) ----
# توکن مشترک Alertmanager و خط لوله‌ی CI/CD برای ارسال هشدار/گزارش به اعلان‌های
# داخل سایت تیم فنی (/api/v1/ops/*). خالی = این مسیرها غیرفعال.
# تولید یک مقدار امن:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_WEBHOOK_TOKEN=
# نقش‌هایی که «تیم فنی» حساب می‌شوند و هشدارها را دریافت می‌کنند (جداشده با کاما)
OPS_ALERT_RECIPIENT_ROLES=Admin

# =============================================================================
# فقط برای Docker Compose (docker-compose.yml) — در اجرای مستقیم بدون Docker لازم نیستند
# =============================================================================
# اطلاعات دیتابیس کانتینر PostgreSQL (DATABASE_URL داخل Docker خودکار از همین‌ها ساخته می‌شود)
POSTGRES_USER=ats
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smart_ats_db
# آدرس عمومی سایت (بدون / انتهایی) — لوکال: http://localhost:8080 | سرور: https://ats.example.com
PUBLIC_BASE_URL=http://localhost:8080
# ورود به Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# فقط سرور: پورت عمومی Gateway (پیش‌فرض 80)
GATEWAY_HTTP_PORT=80
