                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "بازبینی یک سؤال توسط مصاحبه‌کننده: ویرایش متن/کلید پاسخ، تأیید برای بانک سؤال، یادداشت",
        "tags": [
          "GenAI Interview Questions"
        ]
      }
    },
    "/api/v1/genai/question-bank": {
      "get": {
        "description": "فقط سؤال‌های تأییدشده (is_approved) — ایندکس جزئی ix_interview_questions_approved_skill.",
        "operationId": "search_question_bank_api_v1_genai_question_bank_get",
        "parameters": [
          {
            "description": "نام مهارت (بدون حساسیت به حروف)",
            "in": "query",
            "name": "skill",
            "required": false,
            "schema": {
