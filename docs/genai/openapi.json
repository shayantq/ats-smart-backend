  "info": {
    "description": "قرارداد API تولید و بازبینی بانک سؤال مصاحبه — راهنمای کامل: docs/genai/API_CONTRACT.md",
    "title": "ATS Smart — GenAI Interview Questions API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/genai/interview-questions": {
      "get": {
        "operationId": "list_question_sets_api_v1_genai_interview_questions_get",
        "parameters": [
          {
            "description": "شناسه‌ی درخواست شغلی",
            "in": "query",
            "name": "application_id",
            "required": true,
            "schema": {
              "description": "شناسه‌ی درخواست شغلی",
              "format": "uuid",
              "title": "Application Id",
              "type": "string"
            }
          },
          {
            "description": "توکن صفحه‌ای که می‌خواهید بخوانید (از فیلد next_cursor/previous_cursor پاسخ قبلی). خالی = اولین صفحه.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "توکن صفحه‌ای که می‌خواهید بخوانید (از فیلد next_cursor/previous_cursor پاسخ قبلی). خالی = اولین صفحه.",
              "title": "Cursor"
            }
          },
          {
            "description": "جهت حرکت نسبت به cursor: 'next' (صفحه‌ی بعد) یا 'prev' (صفحه‌ی قبل).",
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "default": "next",
              "description": "جهت حرکت نسبت به cursor: 'next' (صفحه‌ی بعد) یا 'prev' (صفحه‌ی قبل).",
              "pattern": "^(next|prev)$",
              "title": "Direction",
              "type": "string"
            }
          },
          {
            "description": "تعداد آیتم در هر صفحه (حداکثر 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "تعداد آیتم در هر صفحه (حداکثر 100).",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionSetListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "فهرست بانک‌های سؤال یک درخواست شغلی (جدیدترین اول)",
        "tags": [
          "GenAI Interview Questions"
        ]
      },
      "post": {
        "description": "یک بانک سؤال با وضعیت pending ثبت و کار تولید به صف genai سپرده می‌شود (پاسخ فوری ۲۰۲)؛ وضعیت با\nGET همان status_url پیگیری می‌شود: pending → processing → completed | failed.",
        "operationId": "request_question_set_api_v1_genai_interview_questions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateQuestionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionSetAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "درخواست شغلی پیدا نشد"
          },
          "409": {
            "description": "رزومه‌ی کارجو هنوز پردازش نشده"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "سرویس هوش مصنوعی مولد پیکربندی نشده یا صف در دسترس نیست"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "درخواست تولید سؤال‌های مصاحبه‌ی اختصاصی برای یک درخواست شغلی (ناهمگام)",
        "tags": [
          "GenAI Interview Questions"
        ]
      }
    },
