        "description": "درخواست تولید بانک سؤال برای یک درخواست شغلی (کارجو × آگهی).",
        "properties": {
          "application_id": {
            "format": "uuid",
            "title": "Application Id",
            "type": "string"
          },
          "difficulty": {
            "default": "mixed",
            "enum": [
              "mixed",
              "easy",
              "medium",
              "hard"
            ],
            "title": "Difficulty",
            "type": "string"
          },
          "focus_skills": {
            "description": "مهارت‌هایی که باید حتماً سنجیده شوند",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Focus Skills",
            "type": "array"
          },
          "language": {
            "default": "fa",
            "enum": [
              "fa",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "question_count": {
            "default": 8,
            "maximum": 15.0,
            "minimum": 3.0,
            "title": "Question Count",
            "type": "integer"
          }
        },
        "required": [
          "application_id"
        ],
        "title": "GenerateQuestionsRequest",
        "type": "object"
      },
