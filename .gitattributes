# اسکریپت‌ها و پیکربندی‌هایی که داخل کانتینرهای لینوکسی/سرور اجرا می‌شوند همیشه با
# پایان خط LF ذخیره شوند (CRLF ویندوزی اسکریپت bash را روی سرور خراب می‌کند)
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
backup/crontab text eol=lf

# فایل‌های باینری هرگز تبدیل پایان خط نشوند (مثلاً PDF نمونه‌ی تست بار — loadtest/sample_resume.pdf)
*.pdf binary
*.png binary
