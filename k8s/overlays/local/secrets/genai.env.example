# Secret «ats-genai-secrets» — سرویس مدل زبانی برای تولید سؤال مصاحبه (backend-api و genai-worker)
# هر سرویس سازگار با پروتکل Chat Completions: نشانی پایه تا /v1، شناسه‌ی مدل همان سرویس، و کلید API.
# خالی بودن GENAI_BASE_URL یا GENAI_MODEL = قابلیت غیرفعال (API پاسخ 503).
#
# سرور مدل داخل همین کلاستر (k8s/overlays/local/genai-inference):
#   GENAI_BASE_URL=http://genai-inference:8080/v1
#   GENAI_MODEL=ats-interview-model
GENAI_BASE_URL=
GENAI_MODEL=
GENAI_API_KEY=
# json_schema (پیش‌فرض) یا json_object برای سرویس‌هایی که خروجی مقید به Schema ندارند
GENAI_STRUCTURED_OUTPUT=json_schema
# سرور مدل روی CPU کند است: سقف انتظار پاسخ (کمتر از job_timeout صف genai = ۶۰۰ ثانیه)
# GENAI_TIMEOUT_SECONDS=540
