# Secret «ats-backend-secrets» — استفاده در: backend-api، worker، migrate (و فقط کلید OPS_WEBHOOK_TOKEN در alertmanager)
# رمز داخل DATABASE_URL باید با POSTGRES_PASSWORD فایل postgres.env یکی باشد
DATABASE_URL=postgresql+asyncpg://ats:CHANGE_ME@postgres:5432/smart_ats_db
SECRET_KEY=CHANGE_ME
OPS_WEBHOOK_TOKEN=CHANGE_ME
SMTP_USERNAME=
SMTP_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
