# Secret «ats-backup-secrets» — سرویس backup و تمرین بازیابی
# کلید عمومی رمزنگاری (age1...): deploy.sh از backup/secrets/public/age-recipient.txt می‌خواند
BACKUP_AGE_RECIPIENT=
# فقط برای Offsite واقعی (S3 / SFTP) — در لوکال خالی
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_SFTP_PASSWORD=
