# مقادیر وابسته به محیط لوکال (Docker Desktop) — روی ConfigMap «ats-config» لایه‌ی پایه Merge می‌شوند
ENVIRONMENT=local-k8s
# سایت از طریق NGINX Ingress Controller: http://localhost:8081
FRONTEND_ORIGIN=http://localhost:8081
MEDIA_BASE_URL=http://localhost:8081/media

# ایمیل‌ها به Mailpit (سرور SMTP آزمایشی داخل کلاستر، mailpit.yaml) — هیچ ایمیلی بیرون نمی‌رود
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
