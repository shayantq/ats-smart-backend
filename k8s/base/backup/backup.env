# تنظیمات غیرحساس سرویس backup (ConfigMap «backup-config») — مقصد Offsite با متغیرهای محیطی rclone
# (ریموت «offsite»). پیش‌فرض Production: یک باکت S3 جدا از این کلاستر؛ Overlay لوکال جایگزین می‌کند.
# کلیدهای دسترسی و کلید عمومی age در Secret «ats-backup-secrets» هستند.
BACKUP_REMOTE=offsite:ats-backups
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_LOG_LEVEL=ERROR
