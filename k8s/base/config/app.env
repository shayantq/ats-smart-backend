# تنظیمات غیرحساس برنامه — به ConfigMap «ats-config» تبدیل و با envFrom به همه‌ی
# کانتینرهای ایمیج بک‌اند (API، Worker، Scheduler، Migrate) داده می‌شود.
# مقادیر محرمانه (رمز دیتابیس، SECRET_KEY، توکن‌ها) اینجا نیستند: Secret «ats-backend-secrets».
PROJECT_NAME=ATS Smart
ENVIRONMENT=production

# آدرس سرویس‌ها = نام Service های Kubernetes (DNS داخلی کلاستر)
REDIS_URL=redis://redis:6379/0

# بک‌اند فقط از داخل کلاستر (ClusterIP) در دسترس است و همه‌ی درخواست‌ها از Ingress/Nginx می‌گذرند؛
# IP واقعی کاربر از X-Forwarded-For خوانده می‌شود (Rate Limit هر کاربر جدا، نه همه‌ی کاربران پشت IP پراکسی).
# Ingress این هدر را با IP اتصال بازنویسی می‌کند (k8s/base/ingress.yaml) پس قابل جعل نیست.
FORWARDED_ALLOW_IPS=*

# ظرفیت Connection Pool هر Pod؛ سقف کل = (حداکثر Pod های HPA + Worker) × (POOL + OVERFLOW)
# که باید زیر max_connections پستگرس (۱۰۰) بماند: (۶ + ۱) × ۱۲ = ۸۴
DB_POOL_SIZE=6
DB_MAX_OVERFLOW=6

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# آدرس عمومی سایت — Overlay هر محیط جایگزین می‌کند
FRONTEND_ORIGIN=https://ats.example.com
MEDIA_BASE_URL=https://ats.example.com/media

# فایل‌های رزومه روی PersistentVolume مشترک (PVC «media»، ReadWriteMany)
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media

# Tesseract داخل ایمیج در PATH است
OCR_LANGUAGES=fas+eng
TESSERACT_CMD_PATH=

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@ats-smart.local
SMTP_FROM_NAME=ATS Smart

OPS_ALERT_RECIPIENT_ROLES=Admin
